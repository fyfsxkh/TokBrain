{
  "name": "tokbrain-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
