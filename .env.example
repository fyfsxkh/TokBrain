# The service is intentionally local-only.
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Mutable limits are normally edited in the Settings page.
DAILY_MEDIA_MINUTES_LIMIT=60
DAILY_LLM_TOKEN_LIMIT=500000
MONTHLY_WARNING_CNY=50
SCENE_THRESHOLD=0.40
MAX_SCENE_CANDIDATES=120
MAX_KEYFRAMES=12
MIN_KEYFRAME_GAP_SECONDS=2

# Link safety limits (10/batch, 150/day, 4-8 second global cooldown) are fixed
# in the application and cannot be raised with environment variables.

# Do not put API keys here. Save them in the UI so DPAPI protects them.
